---
import BaseLayout from '../layouts/BaseLayout.astro';
import EventCard from '../components/EventCard.astro';
import QuickNav from '../components/QuickNav.astro';
import siteContent from '../content/site.json';

const { events } = siteContent;

const photoAlbumUrl = 'https://pov.camera/qr/E7963AE0-775F-4F39-A2E2-F49204B7AC64';
---

<BaseLayout title="O dia 18 · Isabelinha e João" description="Agenda, locais e mapas do dia do casamento.">
  <section class="section section-page-head">
    <div class="container">
      <header class="page-head">
        <h1>O dia 18</h1>
      </header>

      <div class="timeline" aria-label="Timeline do dia 18">
        {
          events.map((event, index) => (
            <div class="timeline-item">
              <span class="timeline-point" aria-hidden="true">{index + 1}</span>
              <EventCard event={event} />
            </div>
          ))
        }
      </div>

      <aside class="photo-share" aria-label="Partilhar fotografias do casamento">
        <p class="photo-share-eyebrow">📸 As vossas fotos</p>
        <h2 class="photo-share-title">Guardem este dia connosco</h2>
        <p class="photo-share-text">
          Tirem e partilhem as vossas fotografias no nosso álbum. Basta abrir o link
          — ou ler o QR Code que estará disponível no dia.
        </p>
        <a class="btn btn-primary photo-share-btn" href={photoAlbumUrl} target="_blank" rel="noopener noreferrer">
          Abrir álbum de fotos
        </a>
      </aside>
    </div>
  </section>

  <QuickNav />

  <style>
    .photo-share {
      margin: 2.6rem auto 0;
      max-width: 34rem;
      padding: 1.6rem 1.5rem 1.75rem;
      text-align: center;
      background: color-mix(in srgb, var(--accent-soft) 55%, white);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      box-shadow: var(--shadow-soft);
    }

    .photo-share-eyebrow {
      margin: 0;
      font-size: 0.85rem;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--muted);
    }

    .photo-share-title {
      margin: 0.4rem 0 0;
      font-size: 1.4rem;
    }

    .photo-share-text {
      margin: 0.6rem auto 0;
      max-width: 26rem;
      color: var(--muted);
      line-height: 1.55;
    }

    .photo-share-btn {
      margin-top: 1.15rem;
    }

    @media (max-width: 520px) {
      .photo-share-btn {
        width: 100%;
      }
    }
  </style>
</BaseLayout>
